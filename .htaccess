# YouthConnekt Mali : toutes les adresses passent par index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fichiers internes jamais accessibles depuis le navigateur
  RewriteRule ^(app|vues|base-de-donnees|stockage|node_modules|assets/src)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.exemple\.php|package\.json|package-lock\.json|README\.md|\.user\.ini|\.git.*)$ - [F,L]
  # Fichiers cachés, sauvegardes, journaux et exports de base, où qu'ils soient
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|log|bak|old|orig|swp|ini|lock|dist|sh)$ - [F,NC,L]

  # Les fichiers qui existent (images, styles...) sont servis directement
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste est confié à index.php
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 index.php
</IfModule>

# Vidéo bilan de l'année : envois plus lourds acceptés (WAMP et serveurs Apache avec PHP en module ;
# les hébergements en PHP-FPM lisent .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 260M
  php_value max_input_time 600
</IfModule>

# Formats parfois inconnus du serveur (photos WhatsApp en .jfif, AVIF, polices du site)
AddType font/woff2 .woff2
AddType image/jpeg .jfif
AddType image/avif .avif

# Mise en cache des images, styles et scripts
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
</IfModule>

# Compression des pages pour les connexions lentes
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/ld+json image/svg+xml
</IfModule>
