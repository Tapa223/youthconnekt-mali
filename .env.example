# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.

# Mode développement : True sur ton PC, False en production
DEBUG=True

# Clé secrète : en générer une avec
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Domaines autorisés, séparés par des virgules
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL : laisser DB_NAME vide pour utiliser SQLite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Adhésion aux communautés : False = validation par un administrateur
COMMUNAUTES_ACCEPTATION_AUTOMATIQUE=False

# Photos de mise en page : False une fois les vraies photos du chapitre en place
PHOTOS_PROVISOIRES=True

# E-mails (confirmation d'inscription, mot de passe oublié, formulaire de contact)
# Laisser EMAIL_HOST vide : les e-mails s'affichent dans le terminal de runserver.
# Le remplir avec les informations SMTP fournies par l'hébergeur pour un envoi réel.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=YouthConnekt Mali <noreply@votre-domaine>
